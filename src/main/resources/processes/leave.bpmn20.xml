<?xml version="1.0" encoding="UTF-8"?>
<definitions xmlns="http://www.omg.org/spec/BPMN/20100524/MODEL"
             xmlns:flowable="http://flowable.org/bpmn"
             targetNamespace="http://flowable.org/test">
    <process id="leave_request" name="请假审批流程" isExecutable="true">
        <startEvent id="start" name="开始"/>
        <userTask id="apply" name="提交请假申请" flowable:assignee="${applicant}"/>
        <userTask id="manager_approve" name="部门经理审批" flowable:candidateGroups="manager"/>
        <userTask id="hr_approve" name="人事审批" flowable:candidateGroups="hr"/>
        <endEvent id="end" name="结束"/>
        <sequenceFlow id="flow1" sourceRef="start" targetRef="apply"/>
        <sequenceFlow id="flow2" sourceRef="apply" targetRef="manager_approve"/>
        <sequenceFlow id="flow3" sourceRef="manager_approve" targetRef="hr_approve"/>
        <sequenceFlow id="flow4" sourceRef="hr_approve" targetRef="end"/>
    </process>
</definitions>
